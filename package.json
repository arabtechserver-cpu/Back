{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node security-regression.test.js && node security-hardening.test.js && node ip-access-control.test.js && node security-upload-deposit.test.js",
    "dev": "nodemon --watch src --exec tsx src/server.ts",
    "build": "npx prisma generate && tsc",
    "prestart": "prisma migrate deploy",
    "start": "node --max-old-space-size=128 --max-semi-space-size=4 dist/server.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:push": "npx prisma db push --skip-generate",
    "catalog:refresh": "node scripts/refresh-zoalna-catalog.cjs",
    "test:manual-catalog": "node --test manual-catalog.test.cjs manual-cart-checkout.test.cjs cart-schema.test.cjs",
    "ip:status": "tsx src/scripts/resetIpRestriction.ts --status",
    "ip:disable": "tsx src/scripts/resetIpRestriction.ts --disable",
    "ip:enable": "tsx src/scripts/resetIpRestriction.ts --enable",
    "ip:add": "tsx src/scripts/resetIpRestriction.ts --add-ip",
    "test:memory": "node --max-old-space-size=128 low-memory-regression.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "prisma": "^5.22.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
