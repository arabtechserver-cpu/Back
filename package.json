    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "deep-email-validator": "^0.1.27",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.6",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "loops": "^7.1.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "whatsapp-web.js": "^1.34.7"
