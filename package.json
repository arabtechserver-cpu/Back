{
  "name": "game-charging-backend",
  "version": "1.0.0",
  "description": "Backend for Spider Store — Game and Program charging store",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "convert-images": "node scripts/convert-inline-images.js",
    "convert-upload-images": "node -e \"require('./convert_images').runMigration().then(() => process.exit(0)).catch((err) => { console.error(err); process.exit(1); })\""
  },
  "dependencies": {
