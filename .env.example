# ==========================================
# Application Configuration
# ==========================================
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://borai.store
# Comma-separated IPs/CIDRs of YOUR reverse proxies, including the internal
# frontend hop. Empty = do not trust forwarded headers. Never use 0.0.0.0/0.
# The public ingress must overwrite X-Forwarded-For; prevent direct access
# to internal frontend/backend ports. See SECURITY-DEPLOYMENT.md.
TRUSTED_PROXY_CIDRS=

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==========================================
# Security (Must match the Frontend)
# ==========================================
JWT_SECRET=replace_with_a_random_32_plus_character_secret

# ==========================================
# Dhru API Credentials
# ==========================================
DHRU_API_URL=https://provider.example/api/v1
DHRU_USERNAME=provider_username
DHRU_API_KEY=provider_api_key

# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=telegram_bot_token

# ==========================================
# Loops (Email) Credentials
# ==========================================
LOOPS_API_KEY=loops_api_key
LOOPS_TRANSACTIONAL_ID_OTP=loops_transactional_otp_id

# ==========================================
# PayPal Credentials
# ==========================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=paypal_client_id
PAYPAL_CLIENT_SECRET=paypal_client_secret
PAYPAL_WEBHOOK_ID=paypal_webhook_id

# ==========================================
# FoxReload API (Gaming & Entertainment)
# ==========================================
FOXRELOAD_API_KEY=your_foxreload_api_key_here

